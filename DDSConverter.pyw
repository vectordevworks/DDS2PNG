    def create_menu(self):

        self.root.config(menu="")

        self.menu_bar = tk.Frame(
            self.root,
            bg=PANEL,
            height=44
        )

        self.menu_bar.pack(
            side="top",
            fill="x"
        )

        self.menu_bar.pack_propagate(False)

        menu_font = ("Segoe UI", 9)

        self.menu_buttons = []
        self.menu_trigger_widgets = []

        # ----------------------------------------------------
        # POPUP MENU
        # ----------------------------------------------------

        def open_menu(menu_data, button):

            if self.is_converting:
                return

            if (
                self.active_menu is not None
                and self.active_menu_button == button
            ):

                self.close_active_menu()
                return

            self.close_active_menu()

            popup = tk.Toplevel(self.root)

            popup.overrideredirect(True)
            popup.configure(bg=BORDER)

            self.active_menu = popup
            self.active_menu_button = button

            x = button.winfo_rootx()

            y = (
                button.winfo_rooty()
                + button.winfo_height()
            )

            popup.geometry(
                f"+{x}+{y}"
            )

            border_frame = tk.Frame(
                popup,
                bg=BORDER,
                padx=1,
                pady=1
            )

            border_frame.pack(
                fill="both",
                expand=True
            )

            menu_frame = tk.Frame(
                border_frame,
                bg=PANEL
            )

            menu_frame.pack(
                fill="both",
                expand=True
            )

            for item in menu_data:

                if item is None:

                    tk.Frame(
                        menu_frame,
                        bg=BORDER,
                        height=1
                    ).pack(
                        fill="x",
                        padx=8,
                        pady=5
                    )

                    continue

                label, command, accelerator = item

                item_frame = tk.Frame(
                    menu_frame,
                    bg=PANEL,
                    cursor="hand2"
                )

                item_frame.pack(
                    fill="x",
                    padx=3,
                    pady=1
                )

                item_label = tk.Label(
                    item_frame,
                    text=label,
                    bg=PANEL,
                    fg=TEXT,
                    font=menu_font,
                    anchor="w",
                    padx=12,
                    pady=7,
                    cursor="hand2"
                )

                item_label.pack(
                    side="left",
                    fill="x",
                    expand=True
                )

                if accelerator:

                    tk.Label(
                        item_frame,
                        text=accelerator,
                        bg=PANEL,
                        fg=MUTED,
                        font=("Segoe UI", 8),
                        padx=12,
                        cursor="hand2"
                    ).pack(
                        side="right"
                    )

                def on_enter(
                    event,
                    frame=item_frame
                ):

                    frame.configure(
                        bg=CARD_HOVER
                    )

                    for child in frame.winfo_children():
                        child.configure(bg=CARD_HOVER)

                def on_leave(
                    event,
                    frame=item_frame
                ):

                    frame.configure(
                        bg=PANEL
                    )

                    for child in frame.winfo_children():
                        child.configure(bg=PANEL)

                def on_click(
                    event,
                    action=command
                ):

                    self.close_active_menu()

                    if action:

                        self.root.after(
                            10,
                            action
                        )

                for widget in item_frame.winfo_children():

                    widget.bind(
                        "<Enter>",
                        on_enter
                    )

                    widget.bind(
                        "<Leave>",
                        on_leave
                    )

                    widget.bind(
                        "<Button-1>",
                        on_click
                    )

                item_frame.bind(
                    "<Enter>",
                    on_enter
                )

                item_frame.bind(
                    "<Leave>",
                    on_leave
                )

                item_frame.bind(
                    "<Button-1>",
                    on_click
                )

            popup.bind(
                "<Escape>",
                lambda event: self.close_active_menu()
            )

            popup.focus_force()

        # ----------------------------------------------------
        # DROPDOWN BUTTON
        # ----------------------------------------------------

        def create_dropdown(title, commands):

            button = tk.Button(
                self.menu_bar,
                text=title,
                bg=PANEL,
                fg=TEXT,
                activebackground=CARD_HOVER,
                activeforeground="#FFFFFF",
                font=menu_font,
                padx=15,
                pady=0,
                relief="flat",
                bd=0,
                highlightthickness=0,
                cursor="hand2",
                takefocus=True
            )

            button.pack(
                side="left",
                fill="y"
            )

            button.configure(
                command=lambda data=commands, b=button:
                open_menu(data, b)
            )

            button.bind(
                "<Enter>",
                lambda event, b=button:
                b.configure(bg=CARD_HOVER)
            )

            button.bind(
                "<Leave>",
                lambda event, b=button:
