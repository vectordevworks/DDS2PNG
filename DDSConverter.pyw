        )

    # ========================================================
    # TEXCONV
    # ========================================================

    def find_texconv(self):

        if TEXCONV_LOCAL_PATH.is_file():
            return str(TEXCONV_LOCAL_PATH)

        path = shutil.which("texconv.exe")

        if path:
            return path

        path = shutil.which("texconv")

        if path:
            return path

        return None

    def check_texconv(self):

        texconv = self.find_texconv()

        if texconv:
            return texconv

        messagebox.showerror(
            self.tr("Texconv bulunamadı"),
            (
                f"{self.tr('Texconv dosyası bulunamadı.')}\n\n"
                f"{self.tr('texconv.exe dosyasını programın bulunduğu klasöre koyun.')}"
            ),
            parent=self.root
        )

        return None

    # ========================================================
    # LANGUAGE SETTINGS
    # ========================================================

    def load_language(self):

        try:

            if CONFIG_FILE.exists():

                with CONFIG_FILE.open(
                    "r",
                    encoding="utf-8"
                ) as file:

                    config = json.load(file)

                language = config.get(
                    "language",
                    "tr"
                )

                if language in LANGUAGES:
                    return language

        except (OSError, ValueError, TypeError):
            pass

        return "tr"

    def save_language(self):

        try:

            CONFIG_DIR.mkdir(
                parents=True,
                exist_ok=True
            )

            config = {
                "language": self.language
            }

            with CONFIG_FILE.open(
                "w",
                encoding="utf-8"
            ) as file:

                json.dump(
                    config,
                    file,
                    ensure_ascii=False,
                    indent=4
                )

        except (OSError, TypeError) as error:

            print(
                f"Language saving error: {error}"
            )

    def tr(self, text):

        if not isinstance(text, str):
            return text

        # Resolve the original Turkish key even if the incoming text
        # is already translated in another supported language.
        source_key = text

        if source_key not in EN:
            for translations in TRANSLATIONS.values():
                for turkish, translated in translations.items():
                    if translated == text:
                        source_key = turkish
                        break
                if source_key != text:
                    break

        if self.language == "tr":
            return source_key

        language_translations = TRANSLATIONS.get(
            self.language,
            EN
        )

        return language_translations.get(
            source_key,
            EN.get(source_key, text)
        )

    def translate_runtime_text(self, text):

        """
        Translate text that was already displayed before a language change.
        Supports Turkish, English, and already-localized source text.
        """

        if not isinstance(text, str) or not text:
            return text

        # Translate complete known phrases first.
        translated = self.tr(text)
        if translated != text:
            return translated

        # For combined status messages, translate each known phrase.
        replacements = {}

        for turkish, english in EN.items():
            replacements[turkish] = self.tr(turkish)
            replacements[english] = self.tr(turkish)

            for translations in TRANSLATIONS.values():
                localized = translations.get(turkish)
                if localized:
                    replacements[localized] = self.tr(turkish)

        for original in sorted(replacements, key=len, reverse=True):
            if original:
                text = text.replace(original, replacements[original])

        return text

    def set_language(self, language):

        if self.is_converting:
            return

        if language not in LANGUAGES:
            return

        if language == self.language:

            self.close_active_menu()
            return

        selected_items = set(
            self.tree.selection()
        )

        focused_item = self.tree.focus()

        try:
            tree_position = self.tree.yview()
        except tk.TclError:
            tree_position = (0, 1)

        progress_value = self.progress["value"]
        progress_maximum = self.progress["maximum"]

        progress_text = self.progress_label.cget("text")
        status_text = self.status_bar.cget("text")

        self.close_active_menu()

        self.language = language
        self.save_language()

        # Update application window title.
        self.root.title(self.get_app_name())

        for widget in self.root.winfo_children():

            try:
                widget.destroy()
            except tk.TclError:
                pass

        self.create_menu()
        self.create_interface()

        for path in self.files:

            status = self.file_status.get(
                str(path),
                "Bekleniyor"
            )

            self.tree.insert(
                "",
                "end",
                iid=str(path),
                values=(
                    path.name,
                    str(path.parent),
                    self.tr(status)
                )
            )

            if str(path) in selected_items:
                self.tree.selection_add(str(path))

        if (
            focused_item
            and self.tree.exists(focused_item)
        ):

            self.tree.focus(focused_item)

        try:
            self.tree.yview_moveto(
                tree_position[0]
            )
        except (tk.TclError, IndexError):
            pass

        self.update_count()

        if self.output_dir:

            self.output_label.config(
                text=str(self.output_dir)
            )

        self.progress.configure(
            maximum=progress_maximum
        )

        self.progress["value"] = progress_value

        self.progress_label.config(
            text=self.translate_runtime_text(progress_text)
        )

        self.status_bar.config(
            text=self.translate_runtime_text(status_text)
        )

        self.root.update_idletasks()

        apply_titlebar_theme(self.root)

    # ========================================================
    # MENU HANDLING
    # ========================================================

    @staticmethod
    def _is_widget_inside(widget, parent):

        current = widget

        while current is not None:

            if current == parent:
                return True

            current = getattr(
                current,
                "master",
                None
            )

        return False

    def _dismiss_menu_on_outside_click(self, event):

        popup = self.active_menu

        if popup is None:
            return

        try:

            if not popup.winfo_exists():

                self.active_menu = None
                self.active_menu_button = None

                return

        except tk.TclError:

            self.active_menu = None
            self.active_menu_button = None

            return

        if self._is_widget_inside(
            event.widget,
            popup
        ):
            return

        for trigger in self.menu_trigger_widgets:

            if self._is_widget_inside(
                event.widget,
                trigger
            ):
                return

        self.close_active_menu()

    def close_active_menu(self):

        popup = self.active_menu

        self.active_menu = None
        self.active_menu_button = None

        if popup is not None:

            try:

                if popup.winfo_exists():
                    popup.destroy()

            except tk.TclError:
                pass

