# ============================================================
# WINDOWS TITLEBAR THEME
# ============================================================

def apply_titlebar_theme(root):

    try:
        dwmapi = ctypes.windll.dwmapi
        user32 = ctypes.windll.user32

        hwnd = user32.GetAncestor(
            root.winfo_id(),
            2
        )

        def set_attribute(attribute, value):

            return dwmapi.DwmSetWindowAttribute(
                hwnd,
                attribute,
                ctypes.byref(value),
                ctypes.sizeof(value)
            )

        dark_mode = ctypes.c_int(1)

        result = set_attribute(
            20,
            dark_mode
        )

        if result != 0:
            set_attribute(19, dark_mode)

        def set_color(attribute, color):

            r = int(color[1:3], 16)
            g = int(color[3:5], 16)
            b = int(color[5:7], 16)

            color_value = ctypes.c_uint(
                r | (g << 8) | (b << 16)
            )

            set_attribute(
                attribute,
                color_value
            )

        set_color(35, BG)
        set_color(36, TEXT)
        set_color(34, BORDER)

    except Exception:
        pass


# ============================================================
# ROUNDED BUTTON
# ============================================================

class RoundedButton(tk.Canvas):

    def __init__(
        self,
        parent,
        text,
        command,
        color,
        hover_color,
        text_color="#FFFFFF",
        font=("Segoe UI", 9, "bold"),
        padx=18,
        height=42,
        radius=12
    ):

        self.button_text = text
        self.command = command

        self.color = color
        self.hover_color = hover_color
        self.text_color = text_color

        self.button_font = tkfont.Font(
            family=font[0],
            size=font[1],
            weight=font[2] if len(font) > 2 else "normal"
        )

        self.height = height
        self.radius = radius

        width = (
            self.button_font.measure(text)
            + padx * 2
        )

        super().__init__(
            parent,
            width=width,
            height=height,
            bg=parent.cget("bg"),
            highlightthickness=0,
            bd=0,
            cursor="hand2"
        )

        self.enabled = True
        self.current_color = color

        self.draw_button()

        self.bind("<Enter>", self.on_enter)
        self.bind("<Leave>", self.on_leave)
        self.bind("<Button-1>", self.on_click)

    def rounded_rectangle(
        self,
        x1,
        y1,
        x2,
        y2,
        radius,
        **kwargs
    ):

        points = []

        corners = [
            (x1 + radius, y1 + radius, 180, 270),
            (x2 - radius, y1 + radius, 270, 360),
            (x2 - radius, y2 - radius, 0, 90),
            (x1 + radius, y2 - radius, 90, 180)
        ]

        for cx, cy, start, end in corners:

            for angle in range(start, end + 1, 10):

                rad = math.radians(angle)

                points.append(
                    (
                        cx + radius * math.cos(rad),
                        cy + radius * math.sin(rad)
                    )
                )

        return self.create_polygon(
            points,
            smooth=True,
            splinesteps=24,
            **kwargs
        )

    def draw_button(self):

        self.delete("all")

        self.rounded_rectangle(
            1,
            1,
            int(self["width"]) - 1,
            self.height - 1,
            self.radius,
            fill=self.current_color,
            outline=""
        )

        self.create_text(
            int(self["width"]) // 2,
            self.height // 2,
            text=self.button_text,
            fill=self.text_color,
            font=self.button_font
        )

    def on_enter(self, event=None):

        if not self.enabled:
            return

        self.current_color = self.hover_color
        self.draw_button()

    def on_leave(self, event=None):

        if not self.enabled:
            return

        self.current_color = self.color
        self.draw_button()

    def on_click(self, event=None):

        if self.enabled and self.command:
            self.command()

    def config(self, **kwargs):

        state = kwargs.pop("state", None)

        if state is not None:

            self.enabled = state != "disabled"

            if self.enabled:

                self.current_color = self.color
                super().config(cursor="hand2")

            else:

                self.current_color = "#30394D"
                super().config(cursor="arrow")

            self.draw_button()

        if kwargs:
            super().config(**kwargs)

    configure = config


