            padx=12,
            pady=0,
            relief="flat",
            bd=0,
            highlightthickness=0,
            cursor="hand2",
            takefocus=True
        )

        language_button.pack(
            side="left",
            fill="y"
        )

        def get_language_commands():

            return [
                (
